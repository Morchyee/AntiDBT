    <FileVersion>0.5.5.4</FileVersion>
    <InformationalVersion>0.5.5-beta.4</InformationalVersion>
    <Company>antiDBT</Company>
    <Product>antiDBT Realtime Subtitles</Product>
  </PropertyGroup>
</Project>
